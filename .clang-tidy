Checks: |
  clang-diagnostic-*,
  clang-analyzer-*,
  performance-*,
  portability-*,
  bugprone-*,
  cppcoreguidelines-*,
  -*avoid-c-arrays,
  -*avoid-magic-numbers,
  -*array-to-pointer-decay,
  -*constant-array-index,
  -*easily-swappable-parameters,
  -*explicit-virtual-functions,
  -*signed-char-misuse,
  -*avoid-non-const-global-variables,
  -*non-private-member-variables-in-classes,
  -*pro-bounds-pointer-arithmetic,
  -*pro-type-vararg'
WarningsAsErrors: ''
HeaderFilterRegex: ''
AnalyzeTemporaryDtors: false
UseColor : true
FormatStyle: 'none'