{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "SciTE",
			"type": "lldb",
			"request": "launch",
			"args": [],
			"cwd": "${workspaceFolder}",
			"linux": {
				"program": "${workspaceFolder}/scite/bin/SciTE",
				"preLaunchTask": "SCiTE GTK3"
			},
			"windows": {
				"type": "cppvsdbg",
				"program": "${workspaceFolder}/scite/win32/${input:winPlatform}/Debug/SciTE.exe",
				"stopAtEntry": false,
				"environment": [],
				"logging": {
					"moduleLoad": false
				}
			}
		}
	],
	"inputs": [
		{
			"id": "winPlatform",
			"options": ["", "x64"],
			"default": "",
			"description": "Target Windows platform",
			"type": "pickString"
		}
	]
}